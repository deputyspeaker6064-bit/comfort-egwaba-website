<style>

/* ===============================
   RESET
================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "DM Sans", sans-serif;
    background: #f7faf7;
    color: #173b2b;
    line-height: 1.7;
}

a {
    text-decoration: none;
}

img {
    max-width: 100%;
    display: block;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
}


/* ===============================
   HEADER
================================ */

header {
    height: 80px;
    background: #003d27;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 3px 15px rgba(0,0,0,.15);
}

.nav-container {
    width: 90%;
    max-width: 1400px;
    height: 100%;
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: white;
}

.logo img {
    width: 50px;
    height: 50px;
    object-fit: contain;
}

.logo-text {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
}

nav {
    display: flex;
    align-items: center;
    gap: 24px;
}

nav a {
    color: white;
    font-size: 13px;
    font-weight: 600;
    transition: .3s;
}

nav a:hover,
nav a.active {
    color: #f2bd24;
}

.contact-btn {
    background: #f2bd24;
    color: #003d27 !important;
    padding: 11px 18px;
    border-radius: 5px;
}

.mobile-menu {
    display: none;
    color: white;
    font-size: 25px;
    cursor: pointer;
}


/* ===============================
   HERO
================================ */

.hero {
    min-height: 540px;

    display: flex;
    align-items: center;

    background:
        linear-gradient(
            90deg,
            rgba(0,61,39,.97),
            rgba(0,61,39,.85),
            rgba(0,61,39,.35)
        ),
        url("images/comfort-egwaba.jpg")
        center right / cover no-repeat;

    color: white;
}

.hero-content {
    max-width: 800px;
}

.hero-label {
    color: #f2bd24;
    text-transform: uppercase;
    letter-spacing: 4px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 15px;
}

.hero h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(45px, 6vw, 72px);
    line-height: 1.08;
    margin-bottom: 20px;
}

.hero h1 span {
    color: #f2bd24;
}

.gold-line {
    width: 75px;
    height: 4px;
    background: #f2bd24;
    margin: 20px 0;
}

.hero p {
    max-width: 700px;
    color: #dcebe3;
    font-size: 17px;
}


/* ===============================
   INTRODUCTION
================================ */

.introduction {
    padding: 95px 0;
}

.intro-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 65px;
    align-items: center;
}

.section-label {
    color: #087c4e;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 13px;
    font-weight: 700;
}

.section-title {
    font-family: "Playfair Display", serif;
    color: #003d27;
    font-size: clamp(35px, 4vw, 50px);
    line-height: 1.2;
    margin: 10px 0 18px;
}

.intro-text p {
    color: #61736b;
    margin-bottom: 18px;
}

.constituency-image img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    object-position: top;
    border-radius: 10px;
    box-shadow: 0 20px 45px rgba(0,0,0,.14);
}


/* ===============================
   REPRESENTATIVE
================================ */

.representative {
    padding: 95px 0;
    background: #eef7ed;
}

.rep-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 65px;
    align-items: center;
}

.rep-image {
    position: relative;
}

.rep-image img {
    width: 100%;
    height: 560px;
    object-fit: cover;
    object-position: top;
    border-radius: 9px;
}

.rep-badge {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;

    background: rgba(0,61,39,.96);
    color: white;

    padding: 18px;

    border-left: 4px solid #f2bd24;
}

.rep-badge strong {
    display: block;
    font-family: "Playfair Display", serif;
    font-size: 19px;
}

.rep-badge span {
    color: #f2bd24;
    font-size: 13px;
}

.rep-content p {
    color: #61736b;
    margin-bottom: 18px;
}


/* ===============================
   AREAS OF REPRESENTATION
================================ */

.areas {
    padding: 95px 0;
}

.heading {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 55px;
}

.heading h2 {
    font-family: "Playfair Display", serif;
    color: #003d27;
    font-size: 45px;
    line-height: 1.2;
    margin: 8px 0 12px;
}

.heading p {
    color: #687970;
}

.area-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.area-card {
    background: white;
    padding: 35px;
    border-radius: 8px;
    border-top: 4px solid #f2bd24;
    box-shadow: 0 8px 25px rgba(0,0,0,.06);
    transition: .3s;
}

.area-card:hover {
    transform: translateY(-7px);
}

.area-icon {
    width: 60px;
    height: 60px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #eaf5ed;
    color: #087c4e;

    border-radius: 50%;

    font-size: 23px;
    margin-bottom: 20px;
}

.area-card h3 {
    font-family: "Playfair Display", serif;
    color: #003d27;
    font-size: 22px;
    margin-bottom: 10px;
}

.area-card p {
    color: #687970;
    font-size: 14px;
}


/* ===============================
   COMMUNITY ENGAGEMENT
================================ */

.engagement {
    padding: 100px 0;
    background: #003d27;
    color: white;
}

.engagement-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 65px;
    align-items: center;
}

.engagement-content .section-label {
    color: #f2bd24;
}

.engagement-content h2 {
    font-family: "Playfair Display", serif;
    font-size: 45px;
    line-height: 1.2;
    margin: 10px 0 20px;
}

.engagement-content p {
    color: #d3e4db;
    margin-bottom: 18px;
}

.engagement-list {
    margin-top: 25px;
}

.engagement-item {
    display: flex;
    gap: 15px;
    margin-bottom: 17px;
}

.engagement-item i {
    color: #f2bd24;
    margin-top: 5px;
}

.engagement-item span {
    color: #dce9e2;
}

.engagement-photo img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    object-position: top;
    border-radius: 9px;
}


/* ===============================
   CONSTITUENCY PRIORITIES
================================ */

.priorities {
    padding: 95px 0;
}

.priority-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.priority {
    display: flex;
    gap: 20px;

    padding: 28px;

    background: white;

    border-radius: 8px;

    box-shadow: 0 7px 25px rgba(0,0,0,.05);
}

.priority-icon {
    min-width: 50px;
    height: 50px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #003d27;
    color: #f2bd24;

    font-size: 20px;
}

.priority h3 {
    font-family: "Playfair Display", serif;
    color: #003d27;
    font-size: 20px;
    margin-bottom: 5px;
}

.priority p {
    color: #687970;
    font-size: 14px;
}


/* ===============================
   CALL TO ACTION
================================ */

.cta {
    background: #f2bd24;
    padding: 75px 0;
}

.cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.cta h2 {
    font-family: "Playfair Display", serif;
    color: #003d27;
    font-size: 40px;
    line-height: 1.2;
    margin-bottom: 8px;
}

.cta p {
    color: #355344;
}

.cta-button {
    background: #003d27;
    color: white;
    padding: 14px 25px;
    border-radius: 5px;
    font-weight: 700;
    white-space: nowrap;
    transition: .3s;
}

.cta-button:hover {
    background: white;
    color: #003d27;
}


/* ===============================
   FOOTER
================================ */

footer {
    background: #002d20;
    color: white;
    padding: 55px 0 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 50px;
}

.footer-brand h3 {
    font-family: "Playfair Display", serif;
    font-size: 22px;
    margin-bottom: 10px;
}

.footer-brand p {
    color: #b9ccc2;
}

.footer-column h4 {
    color: #f2bd24;
    margin-bottom: 15px;
}

.footer-column a {
    display: block;
    color: #d1dfd9;
    font-size: 14px;
    margin-bottom: 7px;
}

.footer-column a:hover {
    color: #f2bd24;
}

.copyright {
    border-top: 1px solid rgba(255,255,255,.15);
    margin-top: 45px;
    padding-top: 20px;
    text-align: center;
    color: #91a89d;
    font-size: 13px;
}


/* ===============================
   MOBILE
================================ */

@media(max-width: 900px) {

    nav {
        display: none;

        position: absolute;
        top: 80px;
        left: 0;

        width: 100%;

        background: #003d27;

        padding: 25px 7%;

        flex-direction: column;
        align-items: flex-start;

        gap: 20px;
    }

    nav.show {
        display: flex;
    }

    .mobile-menu {
        display: block;
    }

    .intro-grid,
    .rep-grid,
    .engagement-grid {
        grid-template-columns: 1fr;
    }

    .area-grid {
        grid-template-columns: 1fr 1fr;
    }

    .priority-list {
        grid-template-columns: 1fr;
    }

    .cta-box {
        flex-direction: column;
        align-items: flex-start;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }
}


@media(max-width: 550px) {

    .logo-text {
        font-size: 11px;
    }

    .logo img {
        width: 42px;
        height: 42px;
    }

    .hero {
        min-height: 540px;
    }

    .hero h1 {
        font-size: 42px;
    }

    .introduction,
    .representative,
    .areas,
    .priorities {
        padding: 65px 0;
    }

    .area-grid {
        grid-template-columns: 1fr;
    }

    .heading h2 {
        font-size: 36px;
    }

    .engagement {
        padding: 65px 0;
    }

    .engagement-content h2 {
        font-size: 36px;
    }

    .cta h2 {
        font-size: 32px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }
}

</style>
</head>


